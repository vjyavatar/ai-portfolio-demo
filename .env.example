# Optional. The public board works with no keys (TradingView scanner + Yahoo, cached).
# Put real values in Render environment settings. Do not commit this file with secrets.

# US stock quotes. Free tier is about 60 calls/minute. Leave blank to skip Finnhub.
FINNHUB_API_KEY=

# Last-resort quotes if TradingView and Yahoo both fail. Free tier is about 8/minute and 800/day.
TWELVE_DATA_API_KEY=

# Quote cache in seconds. Default 60. Raise it if a provider starts rate-limiting.
CELESYS_LIVE_CACHE_SECONDS=60

# Existing private option desks. Not required for the public board.
# India chain on the private desk (SmartAPI). API key, local IP and MAC are required together
# with either a static JWT or the login trio below.
CELESYS_ANGEL_API_KEY=
CELESYS_ANGEL_JWT_TOKEN=
CELESYS_ANGEL_CLIENT_LOCAL_IP=
# Header sent as X-ClientPublicIP. When CELESYS_ANGEL_PROXY_URL is set and this is blank,
# the server sends 139.59.38.68 (the droplet egress address).
CELESYS_ANGEL_CLIENT_PUBLIC_IP=
CELESYS_ANGEL_MAC_ADDRESS=
# Static-IP forward proxy for Angel SmartAPI only (login, quotes, instrument master, order routes).
# Yahoo, TradingView, NSE, Finnhub and Twelve Data are not sent here.
# Example: http://user:pass@139.59.38.68:8888
CELESYS_ANGEL_PROXY_URL=
# Optional daily login. If all three are set, the process mints a TOTP and calls loginByPassword.
# The JWT stays in memory. It is refreshed after an HTTP 401 and once a day around 08:30 IST.
# If any of these are blank, CELESYS_ANGEL_JWT_TOKEN is used instead. Do not log these values.
CELESYS_ANGEL_CLIENT_CODE=
CELESYS_ANGEL_PIN=
CELESYS_ANGEL_TOTP_SECRET=
CELESYS_INDIA_OPTIONS_PROVIDER=angelone
CELESYS_LICENSED_OPTIONS_IN=

# US chain on the private desk (Tradier).
CELESYS_OPTIONS_DATA_TOKEN=
CELESYS_LICENSED_OPTIONS_US=
