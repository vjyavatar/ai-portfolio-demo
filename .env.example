# Optional. The public board works with no keys (TradingView scanner + Yahoo, cached).
# Put real values in Render environment settings. Do not commit this file with secrets.

# US stock quotes. Free tier is about 60 calls/minute. Leave blank to skip Finnhub.
FINNHUB_API_KEY=

# Last-resort quotes if TradingView and Yahoo both fail. Free tier is about 8/minute and 800/day.
TWELVE_DATA_API_KEY=

# Quote cache in seconds. Default 60. Raise it if a provider starts rate-limiting.
CELESYS_LIVE_CACHE_SECONDS=60

# Existing private option desks. Not required for the public board.
# India chain on the private desk (read-only SmartAPI). All of these must be set together.
CELESYS_ANGEL_API_KEY=
CELESYS_ANGEL_JWT_TOKEN=
CELESYS_ANGEL_CLIENT_LOCAL_IP=
CELESYS_ANGEL_CLIENT_PUBLIC_IP=
CELESYS_ANGEL_MAC_ADDRESS=
CELESYS_INDIA_OPTIONS_PROVIDER=angelone
CELESYS_LICENSED_OPTIONS_IN=

# US chain on the private desk (Tradier).
CELESYS_OPTIONS_DATA_TOKEN=
CELESYS_LICENSED_OPTIONS_US=
